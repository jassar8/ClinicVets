<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVetsAvalonia.Views.Auth.LoginView"
             FlowDirection="RightToLeft">

    <Grid Width="900" Height="650" Background="{DynamicResource CvPageBackgroundBrush}">
        <Border Width="760"
                Height="540"
                Background="White"
                CornerRadius="28"
                BorderBrush="{DynamicResource CvCardBorderBrush}"
                BorderThickness="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <Grid ColumnDefinitions="320,*">
            <Border Grid.Column="0"
                    Background="#8ADAE8"
                    CornerRadius="24,0,0,24"
                    Padding="24">
                <StackPanel VerticalAlignment="Center"
                            Spacing="18">
                    <Border Width="190"
                            Height="190"
                            Background="#FFFFFF"
                            CornerRadius="95"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Ellipse Width="132"
                                     Height="132"
                                     Fill="#0797C9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <Ellipse Width="78"
                                     Height="78"
                                     Fill="#F5C85A"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="0,-18,0,0"/>
                            <TextBlock Text="VC"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Clinic Vets"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#114D5E"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="ניהול מרפאה וטרינרית חכם, צבעוני ונוח"
                               FontSize="15"
                               Foreground="#225D6B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        <StackPanel Grid.Column="1"
                    Width="340"
                    Spacing="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="ברוכים הבאים"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource CvPrimaryTextBrush}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="התחברות לחשבון עובד"
                       FontSize="17"
                       TextAlignment="Center"
                       Foreground="{DynamicResource CvSecondaryTextBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="שם משתמש"
                       Foreground="{DynamicResource CvSecondaryTextBrush}"
                       FontSize="13"
                       Margin="0,4,16,-8"/>

            <TextBox x:Name="UsernameInput"
                     PlaceholderText="שם משתמש"
                     Width="310"
                     FlowDirection="LeftToRight"
                     TextChanged="ValidateInputs_Changed"
                     ToolTip.Tip="הכנס שם משתמש באנגלית"/>

            <TextBlock Text="סיסמה"
                       Foreground="{DynamicResource CvSecondaryTextBrush}"
                       FontSize="13"
                       Margin="0,4,16,-8"/>

            <Grid Width="310"
                  ColumnDefinitions="*,44"
                  FlowDirection="LeftToRight">
                <TextBox x:Name="PasswordInput"
                         Grid.Column="0"
                         PlaceholderText="סיסמה"
                         PasswordChar="*"
                         FlowDirection="LeftToRight"
                         TextChanged="ValidateInputs_Changed"
                         ToolTip.Tip="לחץ על העין כדי להציג או להסתיר סיסמה"/>

                <Button x:Name="PasswordEyeButton"
                        Grid.Column="1"
                        Content="👁"
                        Width="40"
                        Height="36"
                        Margin="4,0,0,0"
                        Background="#E9F8FC"
                        BorderBrush="{DynamicResource CvCardBorderBrush}"
                        Foreground="#2F4E6B"
                        ToolTip.Tip="הצג או הסתר סיסמה"
                        Click="TogglePasswordVisibility"/>
            </Grid>

            <Button Content="שכחתי סיסמה?"
                    Width="150"
                    Height="34"
                    Classes="link"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="איפוס סיסמה לפי אימייל וקוד"
                    Click="ForgotPassword_Click"/>

            <TextBlock x:Name="StatusText"
                       Text=""
                       Foreground="#0B7A3B"
                       FontSize="13"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="18"/>

            <TextBlock x:Name="ValidationText"
                       Text=""
                       Foreground="#C62828"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="20"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        FlowDirection="LeftToRight">

                <Button Content="התחברות"
                        Width="145"
                        Height="44"
                        Click="Login_Click"/>

                <Button Content="רישום עובד"
                        Width="155"
                        Height="44"
                        Click="Register_Click"/>
            </StackPanel>

        </StackPanel>
        </Grid>
        </Border>
    </Grid>
</UserControl>