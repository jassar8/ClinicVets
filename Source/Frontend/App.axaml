<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVetsAvalonia.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>

        <Style Selector="Button, TextBox, ComboBox, DatePicker">
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <Style Selector="TextBlock.emoji">
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.password-toggle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#0097C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0097C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#007EA7"/>
            <Setter Property="BorderBrush" Value="#007EA7"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#045E7D"/>
            <Setter Property="BorderBrush" Value="#045E7D"/>
        </Style>

        <Style Selector="Button.dataCard:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.dataCard:pressed">
            <Setter Property="Background" Value="#F8FCFD"/>
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#B9DDE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#B9DDE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
    </Application.Styles>
</Application>