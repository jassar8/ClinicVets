<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVetsAvalonia.Views.VisitsView"
             FlowDirection="RightToLeft">

    <Grid Background="#EAF8FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#D3EEF4"
                BorderThickness="1"
                CornerRadius="28"
                Padding="18"
                Margin="18,22,0,22">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" VerticalAlignment="Top">
                <Button Content="← חזרה לתפריט"
                        Width="150"
                        Height="38"
                        HorizontalAlignment="Left"
                        Background="#12344D"
                        BorderBrush="#12344D"
                        ToolTip.Tip="חזרה לתפריט הראשי"
                        Click="Back_Click"/>

                <TextBlock Text="ניהול ביקורים וטיפולים"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#13293D"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="ביקור, אבחנה, טיפול, תרופה ועלות"
                           FontSize="14"
                           Foreground="#526172"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,-8,0,6"/>

                <Border Background="#F8FCFD"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10"
                        Width="270">
                    <TextBlock x:Name="VisitClockText"
                               Text="--/--/---- --:--:--"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#12344D"
                               TextAlignment="Center"/>
                </Border>

                <TextBox x:Name="AnimalSearchInput"
                         PlaceholderText="חיפוש חיה לפי שם או שבב"
                         Width="270"
                         TextChanged="ValidateInputs_Changed"/>

                <Button Content="חפש חיה"
                        Width="130"
                        Height="35"
                        HorizontalAlignment="Center"
                        Click="SearchAnimal_Click"/>

                <TextBox x:Name="AnimalChipInput"
                         PlaceholderText="מספר שבב 376XXXX"
                         Width="270"
                         FlowDirection="LeftToRight"
                         TextChanged="ValidateInputs_Changed"/>

                <TextBlock Text="תאריך ביקור"
                           HorizontalAlignment="Center"/>

                <DatePicker x:Name="VisitDatePicker"
                            Width="270"/>

                <TextBlock Text="שעת ביקור"
                           HorizontalAlignment="Center"/>

                <Grid Width="270"
                      ColumnDefinitions="*,Auto,*"
                      ColumnSpacing="8"
                      FlowDirection="LeftToRight">
                    <ComboBox x:Name="VisitHourDropdown"
                              Grid.Column="0"
                              SelectionChanged="VisitTimeDropdown_SelectionChanged"/>
                    <TextBlock Grid.Column="1"
                               Text=":"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="VisitMinuteDropdown"
                              Grid.Column="2"
                              SelectionChanged="VisitTimeDropdown_SelectionChanged"/>
                </Grid>

                <TextBox x:Name="ReasonInput"
                         PlaceholderText="סיבת הגעה"
                         Width="270"
                         TextChanged="ValidateInputs_Changed"/>

                <TextBox x:Name="DiagnosisInput"
                         PlaceholderText="הערות כלליות / סיכום ביקור"
                         Width="270"
                         AcceptsReturn="True"
                         Height="55"
                         TextChanged="ValidateInputs_Changed"/>

                <TextBox x:Name="BaseCostInput"
                         PlaceholderText="עלות ביקור"
                         Width="270"
                         FlowDirection="LeftToRight"
                         TextChanged="ValidateInputs_Changed"/>

                <TextBlock Text="הוספת טיפול / קורס"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBox x:Name="TreatmentLineDescriptionInput"
                         PlaceholderText="תיאור טיפול או קורס"
                         Width="270"
                         AcceptsReturn="True"
                         Height="45"
                         TextChanged="ValidateInputs_Changed"/>

                <TextBlock Text="סוג טיפול"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <ComboBox x:Name="TreatmentModeDropdown"
                          Width="270"
                          SelectedIndex="0"
                          SelectionChanged="TreatmentMode_SelectionChanged">
                    <ComboBoxItem Content="בלי תרופה"/>
                    <ComboBoxItem Content="עם תרופה"/>
                </ComboBox>

                <Border x:Name="MedicationFieldsPanel"
                        IsVisible="False"
                        Background="#F8FCFD"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10"
                        Width="290">
                    <StackPanel Spacing="8">
                        <TextBlock Text="פרטי תרופה"
                                   FontWeight="Bold"
                                   Foreground="#007EA7"
                                   TextAlignment="Center"/>

                        <ComboBox x:Name="MedicationDropdown"
                                  Width="260"
                                  SelectionChanged="MedicationDropdown_SelectionChanged"/>

                        <TextBlock x:Name="MedicationStockText"
                                   Text=""
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#526172"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBox x:Name="MedicationQuantityInput"
                                 PlaceholderText="כמות תרופה"
                                 Width="260"
                                 FlowDirection="LeftToRight"
                                 TextChanged="ValidateInputs_Changed"/>
                    </StackPanel>
                </Border>

                <Button Content="הוסף טיפול / קורס"
                        Width="270"
                        Height="38"
                        Click="AddTreatmentLine_Click"/>

                <Border Background="#FFFFFF"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10"
                        Width="290">
                    <StackPanel Spacing="6">
                        <TextBlock Text="טיפולים / קורסים בביקור"
                                   FontWeight="Bold"
                                   Foreground="#007EA7"
                                   TextAlignment="Center"/>
                        <StackPanel x:Name="TreatmentLinesPanel"
                                    Spacing="6"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TotalCostText"
                           Text="עלות כוללת: 0"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Border x:Name="ArrivalPanel"
                        IsVisible="False"
                        Background="#F8FCFD"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="12"
                        Width="290">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ניהול הגעה"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#007EA7"
                                   TextAlignment="Center"/>

                        <TextBlock Text="מופיע רק אחרי בחירת תור קיים"
                                   FontSize="12"
                                   Foreground="#526172"
                                   TextAlignment="Center"/>

                        <ComboBox x:Name="ArrivalStatusDropdown"
                                  Width="260"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="ממתין להגעה"/>
                            <ComboBoxItem Content="הגיע"/>
                            <ComboBoxItem Content="לא הגיע"/>
                        </ComboBox>

                        <TextBox x:Name="ArrivalNoteInput"
                                 PlaceholderText="הערת וטרינר / סיבת אי הגעה"
                                 Width="260"
                                 Height="60"
                                 AcceptsReturn="True"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Text=""
                           Foreground="#C62828"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MinHeight="20"/>

                <WrapPanel HorizontalAlignment="Left"
                           FlowDirection="LeftToRight">
                    <Button x:Name="SaveVisitButton"
                            Content="שמור ביקור"
                            Width="160"
                            Margin="5"
                            Click="SaveVisit_Click"/>

                    <Button x:Name="DeleteVisitButton"
                            Content="מחק ביקור"
                            Width="125"
                            Margin="5"
                            Background="#D64545"
                            BorderBrush="#D64545"
                            Click="DeleteVisit_Click"/>

                    <Button x:Name="MarkArrivedButton"
                            Content="אשר הגעה"
                            Width="125"
                            Margin="5"
                            Background="#1E8F4D"
                            BorderBrush="#1E8F4D"
                            Click="MarkArrived_Click"/>

                    <Button x:Name="MarkNoShowButton"
                            Content="לא הגיע - תור חדש"
                            Width="125"
                            Margin="5"
                            Background="#D97706"
                            BorderBrush="#D97706"
                            Click="MarkNoShowAndCreateNew_Click"/>

                    <Button Content="נקה שדות"
                            Width="125"
                            Margin="5"
                            Background="#12344D"
                            BorderBrush="#12344D"
                            Click="ClearFields_Click"/>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                BorderThickness="1"
                BorderBrush="#D3EEF4"
                Background="White"
                CornerRadius="28"
                Padding="16"
                Margin="18,22,18,22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="6"
                            Margin="0,0,0,14">
                    <TextBlock x:Name="VisitsJournalTitleText"
                               Text="יומן ביקורים"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#13293D"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="VisitsJournalSubtitleText"
                               Text="רשימת ביקורים שמורים לפי תאריך, חיה, אבחנה ועלות"
                               FontSize="13"
                               Foreground="#526172"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="#F8FCFD"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel Spacing="10"
                                FlowDirection="RightToLeft">
                        <WrapPanel HorizontalAlignment="Center"
                                   FlowDirection="RightToLeft">
                            <Button Content="🐶 כלבים"
                                    Width="150"
                                    Height="44"
                                    Margin="5"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Background="#E9F8FC"
                                    Foreground="#12344D"
                                    BorderBrush="#0797C9"
                                    Click="FilterDogs_Click"/>
                            <Button Content="🐱 חתולים"
                                    Width="150"
                                    Height="44"
                                    Margin="5"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Background="#FFF1D6"
                                    Foreground="#12344D"
                                    BorderBrush="#D9822B"
                                    Click="FilterCats_Click"/>
                            <Button Content="🦎 זוחלים"
                                    Width="150"
                                    Height="44"
                                    Margin="5"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Background="#E5F6E8"
                                    Foreground="#12344D"
                                    BorderBrush="#2E9D59"
                                    Click="FilterReptiles_Click"/>
                            <Button Content="🐦 ציפורים"
                                    Width="150"
                                    Height="44"
                                    Margin="5"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Background="#E8ECFF"
                                    Foreground="#12344D"
                                    BorderBrush="#5865C7"
                                    Click="FilterBirds_Click"/>
                        </WrapPanel>

                        <Border Background="#EAF8FB"
                                BorderBrush="#D3EEF4"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="10"
                                HorizontalAlignment="Center"
                                FlowDirection="RightToLeft">
                            <StackPanel Spacing="6"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="צפייה כללית"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#526172"
                                           TextAlignment="Center"/>
                                <Button Content="📅 תורים עתידיים"
                                        Width="180"
                                        Height="38"
                                        Background="#12344D"
                                        Foreground="White"
                                        BorderBrush="#12344D"
                                        Click="ShowUpcomingVisits_Click"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8"
                                    FlowDirection="RightToLeft">
                            <TextBlock x:Name="AnimalQuickCardsTitleText"
                                       Text="בחר סוג חיה לפתיחת רשימת החיות"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#12344D"
                                       TextAlignment="Center"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          MaxHeight="115">
                                <WrapPanel x:Name="AnimalQuickCardsPanel"
                                           HorizontalAlignment="Center"/>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SelectedAnimalPanel"
                        IsVisible="False"
                        Background="#F8FCFD"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14">
                        <Border Width="96"
                                Height="96"
                                Background="#E9F8FC"
                                CornerRadius="26"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedAnimalIconText"
                                       Text="🐾"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedAnimalNameText"
                                       Text="שם חיה"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#13293D"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedAnimalChipText"
                                       Text="שבב:"
                                       FontSize="14"
                                       Foreground="#526172"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedAnimalOwnerText"
                                       Text="בעלים:"
                                       FontSize="14"
                                       Foreground="#526172"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedAnimalVaccineText"
                                       Text="חיסון:"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#007EA7"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedAnimalVisitsCountText"
                                       Text="ביקורים: 0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#12344D"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedAnimalNoteText"
                                       Text="הערת וטרינר: אין הערה"
                                       FontSize="14"
                                       Foreground="#526172"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="ShowAllVisitsButton"
                                Grid.Column="2"
                                Content="כל הביקורים"
                                Width="115"
                                Height="38"
                                VerticalAlignment="Center"
                                Background="#12344D"
                                BorderBrush="#12344D"
                                Click="ShowAllVisits_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="360"
                              FlowDirection="LeftToRight">
                    <Grid FlowDirection="LeftToRight"
                          HorizontalAlignment="Stretch">
                        <WrapPanel x:Name="VisitCardsPanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left"
                                   FlowDirection="LeftToRight"/>
                    </Grid>
                </ScrollViewer>

                <Border Background="#F3FAFD"
                        BorderBrush="#D3EEF4"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14"
                        Margin="0,12,0,0">
                    <TextBlock x:Name="VisitDetailsText"
                               Text="לחץ על כרטיס ביקור כדי לראות את כל הפרטים"
                               FontSize="15"
                               Foreground="#2D3748"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
