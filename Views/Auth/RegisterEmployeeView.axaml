<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVetsAvalonia.Views.Auth.RegisterEmployeeView"
             FlowDirection="RightToLeft">

    <Grid Width="900" Height="650" Background="#BFEFF7">
        <Border Width="760"
                Height="560"
                Background="White"
                CornerRadius="28"
                BorderBrush="#69C5D8"
                BorderThickness="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <Grid ColumnDefinitions="260,*">
            <Border Grid.Column="0"
                    Background="#8ADAE8"
                    CornerRadius="24,0,0,24"
                    Padding="22">
                <StackPanel VerticalAlignment="Center"
                            Spacing="16">
                    <Border Width="150"
                            Height="150"
                            Background="#FFFFFF"
                            CornerRadius="75"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Ellipse Width="104"
                                     Height="104"
                                     Fill="#0797C9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="+"
                                       FontSize="58"
                                       FontWeight="Bold"
                                       Foreground="#F5C85A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="עובד חדש"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#114D5E"
                               TextAlignment="Center"/>

                    <TextBlock Text="רישום מאובטח לצוות המרפאה"
                               FontSize="15"
                               Foreground="#225D6B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        <StackPanel Grid.Column="1"
                    Width="380"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="רישום עובד חדש"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#2D3748"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="שם משתמש"
                       Foreground="#526172"
                       FontSize="13"
                       Margin="0,2,50,-8"/>

            <TextBox x:Name="UsernameInput"
                     PlaceholderText="שם משתמש 6-8 תווים באנגלית"
                     Width="280"
                     FlowDirection="LeftToRight"
                     TextChanged="ValidateInputs_Changed"
                     ToolTip.Tip="שם משתמש באנגלית, 6 עד 8 תווים"/>

            <TextBlock Text="סיסמה"
                       Foreground="#526172"
                       FontSize="13"
                       Margin="0,2,50,-8"/>

            <Grid Width="280"
                  ColumnDefinitions="*,44"
                  FlowDirection="LeftToRight">
                <TextBox x:Name="PasswordInput"
                         Grid.Column="0"
                         PlaceholderText="סיסמה 8-10 תווים"
                         PasswordChar="*"
                         FlowDirection="LeftToRight"
                         TextChanged="ValidateInputs_Changed"
                         ToolTip.Tip="הסיסמה חייבת לכלול אות, ספרה ותו מיוחד"/>

                <Button x:Name="PasswordEyeButton"
                        Grid.Column="1"
                        Content="👁"
                        Width="40"
                        Height="36"
                        Margin="4,0,0,0"
                        Background="#E9F8FC"
                        BorderBrush="#69C5D8"
                        Foreground="#2F4E6B"
                        ToolTip.Tip="הצג או הסתר סיסמה"
                        Click="TogglePasswordVisibility"/>
            </Grid>

            <TextBox x:Name="EmployeeNumberInput"
                     PlaceholderText="מספר עובד 4 ספרות"
                     Width="280"
                     FlowDirection="LeftToRight"
                     TextChanged="ValidateInputs_Changed"
                     ToolTip.Tip="מספר עובד חייב להכיל 4 ספרות"/>

            <TextBox x:Name="IdNumberInput"
                     PlaceholderText="תעודת זהות 9 ספרות"
                     Width="280"
                     FlowDirection="LeftToRight"
                     TextChanged="ValidateInputs_Changed"
                     ToolTip.Tip="תעודת זהות חייבת להכיל 9 ספרות"/>

            <TextBox x:Name="EmailInput"
                     PlaceholderText="אימייל"
                     Width="280"
                     FlowDirection="LeftToRight"
                     TextChanged="ValidateInputs_Changed"
                     ToolTip.Tip="הכנס כתובת אימייל תקינה"/>

            <ComboBox x:Name="RoleDropdown"
                      Width="280"
                      SelectedIndex="0"
                      FlowDirection="LeftToRight">
                <ComboBoxItem Content="מזכיר/ה"/>
                <ComboBoxItem Content="וטרינר/ית"/>
            </ComboBox>

            <TextBlock x:Name="ValidationText"
                       Text=""
                       Foreground="#C62828"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="20"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        FlowDirection="LeftToRight"
                        Margin="0,15,0,0">

                <Button Content="שמור עובד"
                        Width="140"
                        Height="40"
                        Click="SaveEmployee_Click"/>

                <Button Content="חזרה"
                        Width="120"
                        Height="40"
                        Classes="secondary"
                        Click="Back_Click"/>
            </StackPanel>

        </StackPanel>
        </Grid>
        </Border>
    </Grid>
</UserControl>