<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClinicVets</AssemblyName>
    <RootNamespace>ClinicVets.Desktop</RootNamespace>
    <ApplicationTitle>ClinicVets</ApplicationTitle>
    <!-- Icon lives under this project so the Win32 resource compiler and publish apphost always embed it reliably. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>ClinicVets</AssemblyTitle>
    <Description>Veterinary clinic management (desktop)</Description>
    <Product>ClinicVets</Product>
    <Company>ClinicVets</Company>
    <Copyright>Copyright © ClinicVets</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico">
      <LogicalName>ClinicVets.app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\ClinicVetsLogo.png">
      <LogicalName>ClinicVets.logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClinicVets.Application\ClinicVets.Application.csproj" />
    <ProjectReference Include="..\ClinicVets.Infrastructure\ClinicVets.Infrastructure.csproj" />
  </ItemGroup>

</Project>
