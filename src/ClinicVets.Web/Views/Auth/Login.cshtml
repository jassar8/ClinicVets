@model ClinicVets.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Employee Login";
}

<section class="auth-page">
    <div class="auth-header">
        <div class="brand-pill">ClinicVets</div>
        <h1 class="auth-title">Employee Login</h1>
        <p class="auth-subtitle">Sign in to enter the veterinary clinic management system.</p>
    </div>

    <div class="auth-card">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="name@clinicvets.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 auth-btn">Login</button>
        </form>

        <p class="small text-muted mt-3 mb-2">
            New employee?
            <a asp-controller="Auth" asp-action="Register">Create account</a>
        </p>
        <p class="small text-muted mb-0">
            Demo account: <code>vet@clinicvets.com</code> / <code>Vet123!</code>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
