@{
    ViewData["Title"] = "Dashboard";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mb-4">@successMessage</div>
}

<section class="dashboard-panel">
    <h2 class="mb-3">ClinicVets Dashboard</h2>
    <p class="text-muted mb-3">Login completed successfully.</p>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-title">Authentication</div>
                <div class="metric-value text-success">Active</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-title">Module</div>
                <div class="metric-value">Employee Access</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-title">Status</div>
                <div class="metric-value">Demo Ready</div>
            </div>
        </div>
    </div>
</section>
