<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVets.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <SolidColorBrush x:Key="ClinicInputTextBrush" Color="#13293D"/>
        <SolidColorBrush x:Key="ClinicInputPlaceholderBrush" Color="#8A9AAB"/>
        <SolidColorBrush x:Key="ClinicInputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ClinicInputBorderBrush" Color="#B9DDE7"/>
        <SolidColorBrush x:Key="ClinicInputFocusBorderBrush" Color="#0097C7"/>
        <SolidColorBrush x:Key="ClinicSelectionBrush" Color="#B8E8F5"/>
        <SolidColorBrush x:Key="ClinicCaretBrush" Color="#0097C7"/>
        <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ClinicVets/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
