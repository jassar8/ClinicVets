<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style Selector="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#0097C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0097C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#007EA7"/>
            <Setter Property="BorderBrush" Value="#007EA7"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#045E7D"/>
            <Setter Property="BorderBrush" Value="#045E7D"/>
        </Style>

        <Style Selector="Button.dataCard:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.dataCard:pressed">
            <Setter Property="Background" Value="#F8FCFD"/>
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Password visibility / compact icon buttons (avoid global padding clip) -->
        <Style Selector="Button.iconToggle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#E8F9FD"/>
            <Setter Property="BorderBrush" Value="#BFEAF2"/>
            <Setter Property="Foreground" Value="#12344D"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style Selector="Button.iconToggle:pointerover">
            <Setter Property="Background" Value="#D4F3FA"/>
            <Setter Property="BorderBrush" Value="#0097C7"/>
        </Style>

        <Style Selector="Button.iconToggle:pressed">
            <Setter Property="Background" Value="#B8E8F5"/>
            <Setter Property="BorderBrush" Value="#007EA7"/>
        </Style>

        <!-- Text link style on login -->
        <Style Selector="Button.linkButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007EA7"/>
        </Style>

        <Style Selector="Button.linkButton:pointerover">
            <Setter Property="Background" Value="#E8F9FD"/>
            <Setter Property="Foreground" Value="#005F82"/>
        </Style>

        <Style Selector="Button.primaryGradient">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#00B7D7" Offset="0"/>
                    <GradientStop Color="#0097C7" Offset="0.55"/>
                    <GradientStop Color="#007EA7" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.primaryGradient:pointerover">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>

        <Style Selector="Button.outlinePrimary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0097C7"/>
            <Setter Property="BorderBrush" Value="#0097C7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style Selector="Button.outlinePrimary:pointerover">
            <Setter Property="Background" Value="#E8F9FD"/>
        </Style>

        <Style Selector="Button.demoDark">
            <Setter Property="Background" Value="#12344D"/>
            <Setter Property="BorderBrush" Value="#12344D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style Selector="Button.demoDark:pointerover">
            <Setter Property="Background" Value="#1E4966"/>
            <Setter Property="BorderBrush" Value="#1E4966"/>
        </Style>

        <Style Selector="ComboBox.demoCombo">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource ClinicInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ClinicCaretBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ClinicSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource ClinicInputTextBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{StaticResource ClinicInputPlaceholderBrush}"/>
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="#9CCFDF"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ClinicInputBackgroundBrush}"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource ClinicInputFocusBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ClinicInputBackgroundBrush}"/>
        </Style>

        <Style Selector="TextBox:disabled">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Foreground" Value="#526172"/>
            <Setter Property="Background" Value="#F4F8FA"/>
        </Style>

        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource ClinicInputPlaceholderBrush}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource ClinicInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
        </Style>

        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#9CCFDF"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource ClinicInputFocusBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
        </Style>

        <Style Selector="ComboBox:disabled">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Foreground" Value="#526172"/>
            <Setter Property="Background" Value="#F4F8FA"/>
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
        </Style>

        <Style Selector="DatePicker /template/ TextBox">
            <Setter Property="Foreground" Value="{StaticResource ClinicInputTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ClinicInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ClinicInputBorderBrush}"/>
        </Style>
</Styles>
