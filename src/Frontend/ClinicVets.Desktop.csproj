<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClinicVets.Desktop</RootNamespace>
    <AssemblyName>ClinicVets</AssemblyName>
    <ApplicationTitle>ClinicVets</ApplicationTitle>
    <ApplicationIcon>..\..\assets\app\AppIcon_v2.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backend\ClinicVets.Application\ClinicVets.Application.csproj" />
    <ProjectReference Include="..\Backend\ClinicVets.Infrastructure\ClinicVets.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app\AppIcon_v2.ico">
      <LogicalName>ClinicVets.app.ico</LogicalName>
    </EmbeddedResource>
    <AvaloniaResource Include="..\..\assets\branding\logo-64.png" Link="Assets\Images\logo-64.png" />
    <AvaloniaResource Include="..\..\assets\branding\logo-128.png" Link="Assets\Images\logo-128.png" />
    <AvaloniaResource Include="..\..\assets\branding\logo-256.png" Link="Assets\Images\logo-256.png" />
    <AvaloniaResource Include="..\..\assets\branding\logo-512.png" Link="Assets\Images\logo-512.png" />
    <AvaloniaResource Include="..\..\assets\app\AppIcon_v2.ico" Link="Assets\Icons\AppIcon_v2.ico" />
    <AvaloniaResource Include="Styles\AppStyles.axaml" />
  </ItemGroup>

  <PropertyGroup>
    <RunAppSyncScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\docs\Scripts\Sync-RunApp.ps1'))</RunAppSyncScript>
    <RunAppDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\RunApp'))</RunAppDir>
  </PropertyGroup>

  <Target Name="SyncRunAppAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <_TargetDirTrimmed>$([System.IO.Path]::GetFullPath('$(TargetDir.TrimEnd('\'))'))</_TargetDirTrimmed>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RunAppSyncScript)&quot; -Source &quot;$(_TargetDirTrimmed)&quot; -RunAppRoot &quot;$(RunAppDir)&quot;" LogStandardErrorAsError="true" />
  </Target>

  <Target Name="SyncRunAppAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishDirTrimmed Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir.TrimEnd('\'))'))</_PublishDirTrimmed>
    </PropertyGroup>
    <Exec Condition="'$(PublishDir)' != ''" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RunAppSyncScript)&quot; -Source &quot;$(_PublishDirTrimmed)&quot; -RunAppRoot &quot;$(RunAppDir)&quot;" LogStandardErrorAsError="true" />
  </Target>

</Project>
