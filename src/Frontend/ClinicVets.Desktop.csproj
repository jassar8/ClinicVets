<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- v2: .csproj lives in src/Frontend; SDK globs would compile sibling ClinicVets.Wpf (XAML) sources — exclude. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClinicVets.Wpf/**</DefaultItemExcludes>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClinicVets</AssemblyName>
    <RootNamespace>ClinicVets.Desktop</RootNamespace>
    <ApplicationTitle>ClinicVets</ApplicationTitle>
    <ApplicationIcon>..\..\assets\app\ClinicVets.ico</ApplicationIcon>
    <AssemblyTitle>ClinicVets</AssemblyTitle>
    <Description>Veterinary clinic management (WinForms desktop v2)</Description>
    <Product>ClinicVets</Product>
    <Company>ClinicVets</Company>
    <Copyright>Copyright © ClinicVets</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app\ClinicVets.ico">
      <LogicalName>ClinicVets.app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\ClinicVetsLogo.png">
      <LogicalName>ClinicVets.logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backend\ClinicVets.Application\ClinicVets.Application.csproj" />
    <ProjectReference Include="..\Backend\ClinicVets.Infrastructure\ClinicVets.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RunAppSyncScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\docs\Scripts\Sync-RunApp.ps1'))</RunAppSyncScript>
    <RunAppDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\RunApp'))</RunAppDir>
  </PropertyGroup>

  <Target Name="SyncRunAppAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <_TargetDirTrimmed>$([System.IO.Path]::GetFullPath('$(TargetDir.TrimEnd('\'))'))</_TargetDirTrimmed>
    </PropertyGroup>
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RunAppSyncScript)&quot; -Source &quot;$(_TargetDirTrimmed)&quot; -RunAppRoot &quot;$(RunAppDir)&quot;"
      LogStandardErrorAsError="true" />
  </Target>

  <Target Name="SyncRunAppAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishDirTrimmed Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir.TrimEnd('\'))'))</_PublishDirTrimmed>
    </PropertyGroup>
    <Exec
      Condition="'$(PublishDir)' != ''"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RunAppSyncScript)&quot; -Source &quot;$(_PublishDirTrimmed)&quot; -RunAppRoot &quot;$(RunAppDir)&quot;"
      LogStandardErrorAsError="true" />
  </Target>

</Project>
