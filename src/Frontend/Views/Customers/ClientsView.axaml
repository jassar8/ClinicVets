<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVets.Desktop.Views.Customers.ClientsView"
             FlowDirection="RightToLeft">

    <Grid Background="#EAF8FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#D3EEF4"
                BorderThickness="1"
                CornerRadius="28"
                Padding="18"
                Margin="18,22,0,22">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12"
                    HorizontalAlignment="Center">
            <Button Content="← חזרה לתפריט"
                    Width="150"
                    Height="38"
                    HorizontalAlignment="Left"
                    Background="#12344D"
                    BorderBrush="#12344D"
                    ToolTip.Tip="חזרה לתפריט הראשי"
                    Click="Back_Click"/>

            <TextBlock Text="ניהול לקוחות"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#13293D"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="הוסף, חפש ועדכן לקוחות המרפאה"
                       FontSize="14"
                       Foreground="#526172"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,-12,0,8"/>

            <Border Background="#F8FCFD"
                    BorderBrush="#D3EEF4"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="14"
                    Width="320">
                <StackPanel Spacing="8">
                    <TextBlock Text="1. חיפוש מהיר"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#007EA7"
                               TextAlignment="Center"/>

                    <ComboBox x:Name="ClientSearchModeDropdown"
                              Width="290"
                              SelectedIndex="0"
                              ToolTip.Tip="בחר לפי איזה פרט לחפש את הלקוח">
                        <ComboBoxItem Content="תעודת זהות"/>
                        <ComboBoxItem Content="טלפון"/>
                        <ComboBoxItem Content="שם"/>
                        <ComboBoxItem Content="אימייל"/>
                    </ComboBox>

                    <TextBox x:Name="ClientSearchInput"
                             Width="290"
                             PlaceholderText="כתוב ערך לחיפוש"/>

                    <Button Content="חפש לקוח"
                            Width="290"
                            Height="40"
                            Click="SearchClient_Click"/>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D3EEF4"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="14"
                    Width="320">
                <StackPanel Spacing="10">
                    <TextBlock Text="2. פרטי לקוח"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#007EA7"
                               TextAlignment="Center"/>

                    <TextBox x:Name="FullNameInput"
                             PlaceholderText="שם מלא"
                             Width="290"
                             TextChanged="ValidateInputs_Changed"/>

                    <ComboBox x:Name="GenderDropdown"
                              Width="290"
                              SelectedIndex="0"
                              ToolTip.Tip="בחר מין הלקוח כדי לעצב את הכרטיס">
                        <ComboBoxItem Content="זכר"/>
                        <ComboBoxItem Content="נקבה"/>
                    </ComboBox>

                    <TextBox x:Name="IdNumberInput"
                             PlaceholderText="תעודת זהות"
                             Width="290"
                             TextChanged="ValidateInputs_Changed"/>

                    <TextBox x:Name="PhoneInput"
                             PlaceholderText="טלפון"
                             Width="290"
                             TextChanged="ValidateInputs_Changed"/>

                    <TextBox x:Name="EmailInput"
                             PlaceholderText="אימייל"
                             Width="290"
                             TextChanged="ValidateInputs_Changed"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ValidationText"
                       Text=""
                       Foreground="#C62828"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="20"/>

            <Border Background="#F8FCFD"
                    BorderBrush="#D3EEF4"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="14"
                    Width="320">
                <StackPanel Spacing="10">
                    <TextBlock Text="3. פעולות"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#007EA7"
                               TextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Content="הוסף לקוח"
                                Height="40"
                                Click="AddClient_Click"/>

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Content="עדכן לקוח"
                                Height="40"
                                Click="UpdateClient_Click"/>

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Content="נקה שדות"
                                Height="40"
                                Background="#12344D"
                                BorderBrush="#12344D"
                                Click="ClearFields_Click"/>

                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Content="חיות הלקוח"
                                Height="40"
                                Background="#12344D"
                                BorderBrush="#12344D"
                                Click="OpenClientAnimals_Click"/>

                        <Button Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Content="מחק לקוח"
                                Height="40"
                                Background="#D64545"
                                BorderBrush="#D64545"
                                Click="DeleteClient_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                BorderThickness="1"
                BorderBrush="#D3EEF4"
                Background="White"
                CornerRadius="28"
                Padding="16"
                Margin="18,22,18,22">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Spacing="6"
                            Margin="0,0,0,14">
                    <TextBlock Text="מאגר הלקוחות"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#13293D"
                               TextAlignment="Center"/>
                    <TextBlock Text="כל הלקוחות הרשומים במערכת, כולל אפשרות להציג חיות של לקוח"
                               FontSize="13"
                               Foreground="#526172"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,*">
                    <Border Background="#F3FAFD"
                            BorderBrush="#D3EEF4"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <TextBlock x:Name="ClientDetailsText"
                                       Grid.Column="0"
                                       Text="לחץ על כרטיס לקוח כדי לראות את כל הפרטים"
                                       FontSize="15"
                                       Foreground="#2D3748"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="BackToClientsButton"
                                    Grid.Column="1"
                                    Content="חזרה לרשימת לקוחות"
                                    Width="180"
                                    Height="40"
                                    IsVisible="False"
                                    Background="#476A88"
                                    BorderBrush="#476A88"
                                    Click="BackToClients_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ClientCardsPanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>