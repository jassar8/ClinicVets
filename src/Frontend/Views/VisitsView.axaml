<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVets.Desktop.Views.VisitsView"
             FlowDirection="RightToLeft">

    <Grid Background="#EAF8FB">
        <Border Width="720"
                MinHeight="420"
                Background="White"
                CornerRadius="28"
                BorderBrush="#D3EEF4"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="36">
            <StackPanel Spacing="18" HorizontalAlignment="Center">
                <Button Content="← חזרה לתפריט"
                        Width="150"
                        Height="38"
                        HorizontalAlignment="Left"
                        Background="#12344D"
                        BorderBrush="#12344D"
                        Click="Back_Click"/>

                <TextBlock Text="ביקורים"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#12344D"
                           TextAlignment="Center"/>

                <TextBlock Text="מודול הביקורים אינו זמין בגרסת v2. המסך נשמר בעיצוב זהה ל-main לצורך ניווט."
                           FontSize="16"
                           Foreground="#526172"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
