<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVets.Desktop.Views.BillsView"
             FlowDirection="RightToLeft">

    <Grid Background="#EAF8FB">
        <Border Background="White"
                BorderBrush="#D3EEF4"
                BorderThickness="1"
                CornerRadius="28"
                Padding="28"
                Margin="40"
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <Button Content="← חזרה לתפריט"
                        Width="150"
                        Height="38"
                        HorizontalAlignment="Left"
                        Background="#12344D"
                        BorderBrush="#12344D"
                        Click="Back_Click"/>

                <TextBlock Text="חשבונות ותשלומים"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#13293D"
                           TextAlignment="Center"/>

                <TextBlock Text="מודול החשבונות אינו זמין בגרסת v2."
                           FontSize="16"
                           Foreground="#526172"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <TextBlock Text="המסך נפתח בבטחה ללא קריסה. ניהול חשבוניות יתווסף בגרסה עתידית."
                           FontSize="14"
                           Foreground="#7A8B99"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
