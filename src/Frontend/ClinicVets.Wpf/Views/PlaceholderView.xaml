<UserControl x:Class="ClinicVets.Wpf.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel VerticalAlignment="Center" MaxWidth="640">
    <TextBlock x:Name="TitleBlock" Style="{StaticResource Text.Title}" FontSize="24" />
    <TextBlock x:Name="BodyBlock"
               Style="{StaticResource Text.Subtitle}"
               FontSize="15"
               Margin="0,12,0,0"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
