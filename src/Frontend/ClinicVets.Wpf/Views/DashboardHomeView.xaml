<UserControl x:Class="ClinicVets.Wpf.Views.DashboardHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="Welcome" Style="{StaticResource Text.Title}" FontSize="26" />
    <TextBlock Text="Here's a quick snapshot of your clinic workspace."
               Style="{StaticResource Text.Subtitle}"
               Margin="0,6,0,24" />

    <UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">
      <Border Style="{StaticResource Card.Border}" Margin="0,0,12,0" Padding="20">
        <StackPanel>
          <TextBlock Text="Customers" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />
          <TextBlock x:Name="MetricCustomers" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.TealMain}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card.Border}" Margin="0,0,12,0" Padding="20">
        <StackPanel>
          <TextBlock Text="Animals" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />
          <TextBlock x:Name="MetricAnimals" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.TealMain}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card.Border}" Padding="20">
        <StackPanel>
          <TextBlock Text="Today's visits" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />
          <TextBlock Text="8" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.TealMain}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Style="{StaticResource Card.Border}">
      <StackPanel>
        <TextBlock Text="Quick actions" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="Use the sidebar to open customers, animals, visits, and treatments."
                   Style="{StaticResource Text.Subtitle}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
