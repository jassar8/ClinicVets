<UserControl x:Class="ClinicVets.Wpf.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.36*" MinWidth="280" />
      <ColumnDefinition Width="0.64*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#0D5E58" Offset="0" />
          <GradientStop Color="#0F766E" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel VerticalAlignment="Center" Margin="40">
        <Image x:Name="BrandLogo" Width="72" Height="72" Stretch="Uniform" Margin="0,0,0,20" />
        <TextBlock Text="Join the team" Style="{StaticResource Text.Hero}" FontSize="28" />
        <TextBlock Text="Submit your details. An administrator will approve your account."
                   FontSize="15"
                   Foreground="{StaticResource Brush.MintAccent}"
                   TextWrapping="Wrap"
                   MaxWidth="320"
                   Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" VerticalAlignment="Center">
      <Border Style="{StaticResource Card.Border}" MaxWidth="520" HorizontalAlignment="Center" Margin="40">
        <StackPanel>
          <TextBlock Text="Register" Style="{StaticResource Text.Title}" FontSize="26" />
          <TextBlock Text="Self-service registration for clinic staff."
                     Style="{StaticResource Text.Subtitle}"
                     Margin="0,6,0,0" />

          <TextBlock Text="Full name" Style="{StaticResource Field.Caption}" Margin="0,16,0,0" />
          <TextBox x:Name="FullName" />

          <TextBlock Text="Email" Style="{StaticResource Field.Caption}" />
          <TextBox x:Name="Email" />

          <TextBlock Text="Password" Style="{StaticResource Field.Caption}" />
          <PasswordBox x:Name="PasswordBox" />

          <TextBlock Text="Role" Style="{StaticResource Field.Caption}" />
          <ComboBox x:Name="RoleCombo" SelectedIndex="0">
            <ComboBoxItem Content="Secretary" />
            <ComboBoxItem Content="Veterinarian" />
          </ComboBox>

          <Border x:Name="Feedback" Margin="0,16,0,0" Padding="12" CornerRadius="10" Visibility="Collapsed">
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" />
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Back" Style="{StaticResource Btn.Outline}" MinWidth="120" Click="OnBack" />
            <Button Content="Submit" Style="{StaticResource Btn.Primary}" MinWidth="140" Margin="12,0,0,0" Click="OnSubmit" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
