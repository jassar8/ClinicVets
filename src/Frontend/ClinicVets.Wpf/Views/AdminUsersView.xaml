<UserControl x:Class="ClinicVets.Wpf.Views.AdminUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}" />
      <ComboBox x:Name="FilterCombo" Width="200" SelectionChanged="OnFilterChanged" />
      <Button Content="Refresh" Style="{StaticResource Btn.Outline}" Margin="12,0,0,0" Click="OnRefresh" />
    </StackPanel>

    <DataGrid x:Name="Grid"
              Grid.Row="1"
              AutoGenerateColumns="True"
              IsReadOnly="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              SelectionChanged="OnSelectionChanged"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" />

    <Border x:Name="ActionPanel"
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="16"
            CornerRadius="14"
            Background="#F0FDFA"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="ActionTitle" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <StackPanel x:Name="ApprovePanel" Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="Final role" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="FinalRole" Width="180" SelectedIndex="0">
            <ComboBoxItem Content="Secretary" />
            <ComboBoxItem Content="Veterinarian" />
            <ComboBoxItem Content="Administrator" />
          </ComboBox>
          <Button Content="Approve" Style="{StaticResource Btn.Primary}" Margin="12,0,0,0" Click="OnApprove" />
          <Button Content="Reject" Style="{StaticResource Btn.Outline}" Margin="8,0,0,0" Click="OnReject" />
        </StackPanel>
        <TextBlock x:Name="ActionMessage" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
