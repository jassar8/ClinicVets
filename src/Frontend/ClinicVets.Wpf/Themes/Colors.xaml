<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.TealMain">#0F766E</Color>
  <Color x:Key="Color.TealSidebar">#115E59</Color>
  <Color x:Key="Color.TealHover">#0D5E58</Color>
  <Color x:Key="Color.MintAccent">#CCFBF1</Color>
  <Color x:Key="Color.Canvas">#F5F7F7</Color>
  <Color x:Key="Color.Card">#FFFFFF</Color>
  <Color x:Key="Color.Text">#1F2937</Color>
  <Color x:Key="Color.TextMuted">#6B7280</Color>
  <Color x:Key="Color.Border">#E2E8E6</Color>
  <Color x:Key="Color.Error">#EF4444</Color>
  <Color x:Key="Color.WarningBg">#FFFBEB</Color>
  <Color x:Key="Color.WarningFg">#924D0E</Color>

  <SolidColorBrush x:Key="Brush.TealMain" Color="{StaticResource Color.TealMain}" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.TealSidebar}" />
  <SolidColorBrush x:Key="Brush.TealHover" Color="{StaticResource Color.TealHover}" />
  <SolidColorBrush x:Key="Brush.MintAccent" Color="{StaticResource Color.MintAccent}" />
  <SolidColorBrush x:Key="Brush.PageBg" Color="{StaticResource Color.Canvas}" />
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.White" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
  <SolidColorBrush x:Key="Brush.WarningBg" Color="{StaticResource Color.WarningBg}" />
  <SolidColorBrush x:Key="Brush.WarningFg" Color="{StaticResource Color.WarningFg}" />
</ResourceDictionary>
