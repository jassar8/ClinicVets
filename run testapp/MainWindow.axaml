<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClinicVetsAvalonia.MainWindow"
        Title="מערכת ניהול מרפאה וטרינרית · ClinicVets v4"
        Width="900"
        Height="650"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CvShellBackgroundBrush}">

    <Border x:Name="MainContent"
            Width="900"
            Height="650"
            Background="{DynamicResource CvShellBackgroundBrush}"/>

</Window>