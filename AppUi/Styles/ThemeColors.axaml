<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CvPageBackground">#BFEFF7</Color>
    <SolidColorBrush x:Key="CvPageBackgroundBrush" Color="{StaticResource CvPageBackground}" />

    <Color x:Key="CvShellBackground">#F3F6FB</Color>
    <SolidColorBrush x:Key="CvShellBackgroundBrush" Color="{StaticResource CvShellBackground}" />

    <Color x:Key="CvCardBorder">#69C5D8</Color>
    <SolidColorBrush x:Key="CvCardBorderBrush" Color="{StaticResource CvCardBorder}" />

    <Color x:Key="CvPrimaryText">#2D3748</Color>
    <SolidColorBrush x:Key="CvPrimaryTextBrush" Color="{StaticResource CvPrimaryText}" />

    <Color x:Key="CvSecondaryText">#526172</Color>
    <SolidColorBrush x:Key="CvSecondaryTextBrush" Color="{StaticResource CvSecondaryText}" />
</ResourceDictionary>
